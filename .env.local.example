# Copy this file to .env.local and fill in your real values.
# .env.local is gitignored, so your secrets never get committed.

# ── Server-side only (never exposed to the browser) ──────────────────

# Used by src/app/api/subscribe/route.ts
N8N_WEBHOOK_URL=https://your-n8n-instance.example.com/webhook/kip-leads

# Paystack secret key — Settings → API Keys & Webhooks in the Paystack
# dashboard. Start with the TEST key (sk_test_...), switch to LIVE
# (sk_live_...) after a successful end-to-end test purchase.
# While this is empty, Buy Now buttons fall back to each product's
# external paymentLink (e.g. Skillspad).
PAYSTACK_SECRET_KEY=

# Meta Conversions API token — Events Manager → your pixel → Settings →
# Conversions API → Generate access token. Optional but strongly
# recommended: recovers Purchases lost to ad blockers / iOS privacy.
META_CAPI_ACCESS_TOKEN=

# Optional: test event code from Events Manager → Test Events, to watch
# server-side Purchases arrive live before launch. REMOVE after testing.
META_CAPI_TEST_EVENT_CODE=

# ── Public — safe to expose in the browser (build-time: rebuild after
#    changing any of these) ───────────────────────────────────────────

NEXT_PUBLIC_WHATSAPP_NUMBER=233241234567
NEXT_PUBLIC_SITE_URL=https://thekipacademy.com
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Meta Pixel ID — Events Manager → your pixel → Settings. Used by both
# the browser pixel (MetaPixel.tsx) and the Conversions API.
NEXT_PUBLIC_FB_PIXEL_ID=
